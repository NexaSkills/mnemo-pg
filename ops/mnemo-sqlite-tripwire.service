[Unit]
Description=mnemo-pg SQLite resurrection tripwire
After=local-fs.target

[Service]
Type=oneshot
# REPO is materialized by mnemo_update.sh; fall back to the dev checkout.
# The check lives inside a plugin-owned script; MNEMO_TRIPWIRE_LOOKBACK comes
# from root .env if present (systemd EnvironmentFile) — default 6h in-script.
Environment=REPO=%h/plugins/mnemo-pg
EnvironmentFile=-%h/.hermes/.env
ExecStart=/bin/sh -c "test -f ${REPO}/scripts/retire_check.py && exec python3 ${REPO}/scripts/retire_check.py || exec python3 ${HOME}/workspace/mnemo-pg/repo/scripts/retire_check.py"

