[Unit]
Description=mnemo-pg SQLite resurrection tripwire

[Service]
Type=oneshot
# REPO is materialized by mnemo_update.sh; fall back to the dev checkout.
# MNEMO_TRIPWIRE_LOOKBACK comes from root .env if present — default 6h in-script.
Environment=REPO=%h/.hermes/plugins/mnemo-pg
EnvironmentFile=-%h/.hermes/.env
ExecStart=/bin/sh -c 'for d in "${REPO}" ${HOME}/.hermes/plugins/mnemo-pg ${HOME}/.hermes/plugins/mnemosyne ${HOME}/workspace/mnemo-pg/repo; do if [ -f "${d}/scripts/retire_check.py" ]; then exec python3 "${d}/scripts/retire_check.py"; fi; done; echo "retire_check.py not found in any candidate REPO dir"; exit 1'
