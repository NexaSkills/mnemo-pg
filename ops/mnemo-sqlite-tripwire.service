[Unit]
Description=mnemo-pg SQLite resurrection tripwire

[Service]
Type=oneshot
# REPO is materialized by mnemo_update.sh; fall back to the dev checkout.
# MNEMO_TRIPWIRE_LOOKBACK comes from root .env if present — default 6h in-script.
Environment=REPO=%h/.hermes/plugins/mnemo-pg
EnvironmentFile=-%h/.hermes/.env
ExecStart=/bin/sh -c 'P=scripts/retire_check.py; for d in "${REPO}" "$HOME"/workspace/mnemo-pg/repo "$HOME"/.hermes/plugins/mnemo-pg "$HOME"/.hermes/plugins/mnemosyne "$HOME"/.hermes/mnemo-pg/repo; do [ -f "$d/$P" ] && exec python3 "$d/$P"; done; echo "retire_check.py not found" >&2; exit 1'
